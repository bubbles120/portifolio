function ativarMenuMobile() {
  const botao = document.getElementById("menuToggle");
  const menu = document.getElementById("nav");

  if (!botao || !menu) return;

  botao.addEventListener("click", function () {
    const abriu = menu.classList.toggle("aberto");
    botao.classList.toggle("aberto");

    botao.setAttribute("aria-expanded", abriu ? "true" : "false");
  });

  const links = menu.querySelectorAll("a");
  links.forEach(function (link) {
    link.addEventListener("click", function () {
      menu.classList.remove("aberto");
      botao.classList.remove("aberto");
      botao.setAttribute("aria-expanded", "false");
    });
  });
}

function ativarCabecalhoAoRolar() {
  const cabecalho = document.getElementById("cabecalho");
  if (!cabecalho) return;

  window.addEventListener("scroll", function () {
    if (window.scrollY > 40) {
      cabecalho.classList.add("rolado");
    } else {
      cabecalho.classList.remove("rolado");
    }
  });
}

function ativarCursorPersonalizado() {
  const cursor = document.getElementById("cursor");
  if (!cursor) return;

  const temMouse = window.matchMedia("(pointer: fine)").matches;
  if (!temMouse) return;

  document.addEventListener("mousemove", function (evento) {
    cursor.style.transform =
      "translate3d(" + evento.clientX + "px, " + evento.clientY + "px, 0)";

    cursor.classList.add("visivel");
  });
}

function ativarBarrasDeHabilidade() {
  const habilidades = document.querySelectorAll(".habilidade");
  if (habilidades.length === 0) return;

  function aoAparecerNaTela(entradas, observador) {
    entradas.forEach(function (entrada) {
      if (!entrada.isIntersecting) return;

      const item = entrada.target;
      const nivel = item.getAttribute("data-nivel");
      const barra = item.querySelector(".habilidade-barra-preenchida");

      if (barra) {
        barra.style.width = nivel + "%";
      }

      observador.unobserve(item);
    });
  }

  const observador = new IntersectionObserver(aoAparecerNaTela, {
    threshold: 0.4,
  });

  habilidades.forEach(function (item) {
    observador.observe(item);
  });
}

function ativarCarrossel() {
  const trilha = document.getElementById("carrosselTrilha");
  const pontosContainer = document.getElementById("carrosselPontos");
  const botaoAnterior = document.getElementById("btnAnterior");
  const botaoProxima = document.getElementById("btnProxima");

  if (!trilha || !pontosContainer || !botaoAnterior || !botaoProxima) return;

  const mapaContainer = document.getElementById("carrosselMapa");
  const contador = document.getElementById("carrosselContador");
  const barraProgresso = document.getElementById("carrosselBarra");

  const cartoes = trilha.querySelectorAll(".cartao-projeto");
  const total = cartoes.length;

  let indiceAtual = 0;
  let temporizador = null;

  const pontos = [];
  cartoes.forEach(function (_cartao, indice) {
    const ponto = document.createElement("button");
    ponto.classList.add("carrossel-ponto");
    ponto.setAttribute("aria-label", "Ir para o projeto " + (indice + 1));

    ponto.addEventListener("click", function () {
      irParaCartao(indice);
      reiniciarAutoplay();
    });

    pontosContainer.appendChild(ponto);
    pontos.push(ponto);
  });

  const nosMapa = [];
  if (mapaContainer) {
    cartoes.forEach(function () {
      const no = document.createElement("span");
      no.classList.add("carrossel-mapa-no");
      mapaContainer.appendChild(no);
      nosMapa.push(no);
    });
  }

  function irParaCartao(indice) {
    indiceAtual = (indice + total) % total;

    trilha.style.transform = "translateX(-" + indiceAtual * 100 + "%)";

    atualizarIndicadores();
    reiniciarBarraProgresso();
  }

  function atualizarIndicadores() {
    pontos.forEach(function (ponto, indice) {
      ponto.classList.toggle("ativo", indice === indiceAtual);
    });

    nosMapa.forEach(function (no, indice) {
      no.classList.toggle("ativo", indice === indiceAtual);
    });

    if (contador) {
      contador.textContent = (indiceAtual + 1) + " / " + total;
    }
  }

  function reiniciarBarraProgresso() {
    if (!barraProgresso) return;
    barraProgresso.style.animation = "none";
    void barraProgresso.offsetWidth;
    barraProgresso.style.animation = "autopreencher 6s linear infinite";
  }

  function iniciarAutoplay() {
    temporizador = setInterval(function () {
      irParaCartao(indiceAtual + 1);
    }, 6000);
  }

  function reiniciarAutoplay() {
    clearInterval(temporizador);
    iniciarAutoplay();
  }

  botaoAnterior.addEventListener("click", function () {
    irParaCartao(indiceAtual - 1);
    reiniciarAutoplay();
  });

  botaoProxima.addEventListener("click", function () {
    irParaCartao(indiceAtual + 1);
    reiniciarAutoplay();
  });

  irParaCartao(0);
  iniciarAutoplay();
}

function ativarFormularioDeContato() {
  const formulario = document.getElementById("formularioContato");
  const resposta = document.getElementById("formularioResposta");

  if (!formulario || !resposta) return;

  const campoNome = document.getElementById("campoNome");
  const campoEmail = document.getElementById("campoEmail");
  const campoMensagem = document.getElementById("campoMensagem");

  formulario.addEventListener("submit", function (evento) {
    evento.preventDefault();

    const camposParaChecar = [campoNome, campoEmail, campoMensagem];
    let tudoPreenchido = true;

    camposParaChecar.forEach(function (campo) {
      const preenchido = campo.value.trim().length > 0;

      campo.closest(".campo").classList.toggle("campo-erro", !preenchido);

      if (!preenchido) {
        tudoPreenchido = false;
      }
    });

    if (!tudoPreenchido) {
      resposta.textContent = "Preencha todos os campos antes de enviar.";
      resposta.className = "formulario-resposta erro";
      return;
    }

    const email = campoEmail.value.trim();
    const emailPareceValido = email.includes("@") && email.includes(".");

    if (!emailPareceValido) {
      campoEmail.closest(".campo").classList.add("campo-erro");
      resposta.textContent = "Digite um e-mail válido.";
      resposta.className = "formulario-resposta erro";
      return;
    }

    enviarFormulario({
      nome: campoNome.value.trim(),
      email: email,
      mensagem: campoMensagem.value.trim(),
    });

    resposta.textContent = "Mensagem enviada! Obrigada, " + campoNome.value.trim() + ".";
    resposta.className = "formulario-resposta sucesso";

    formulario.reset();
  });
}

function enviarFormulario(dados) {
  console.log("Novo contato recebido:", dados);
}

document.addEventListener("DOMContentLoaded", function () {
  ativarMenuMobile();
  ativarCabecalhoAoRolar();
  ativarCursorPersonalizado();
  ativarBarrasDeHabilidade();
  ativarCarrossel();
  ativarFormularioDeContato();
});